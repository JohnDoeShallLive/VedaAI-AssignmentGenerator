{
  "name": "vedaai-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter vedaai-api dev\" \"pnpm --filter vedaai-web dev\"",
    "build": "pnpm --filter @vedaai/types build && pnpm --filter vedaai-api build && pnpm --filter vedaai-web build",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
